[layer_names]

3d_render/layer_17="SimpleGrassTextured interactive layer"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Train"
3d_physics/layer_5="Buildable"
3d_physics/layer_6="Interactable"
3d_physics/layer_7="Projectile"
3d_physics/layer_8="BuildDetect"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0

[shader_globals]

gnd_wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.3)
}
gnd_wind_speed={
"type": "float",
"value": 1.0
}
gnd_wind_strength={
"type": "float",
"value": 4.0
}
sgt_legacy_renderer={
"type": "int",
"value": 0
}
sgt_player_position={
"type": "vec3",
"value": Vector3(1000000, 1000000, 1000000)
}
sgt_player_mov={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sgt_normal_displacement={
"type": "sampler2D",
"value": "res://grass/normal.png"
}
sgt_motion_texture={
"type": "sampler2D",
"value": "res://grass/motion.png"
}
sgt_wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
sgt_wind_movement={
"type": "vec3",
"value": Vector2(0, 0)
}
sgt_wind_strength={
"type": "float",
"value": 0.15
}
sgt_wind_turbulence={
"type": "float",
"value": 1.0
}
sgt_wind_pattern={
"type": "sampler2D",
"value": "res://grass/wind_pattern.png"
}
